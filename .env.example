# Supabase (local values come from `pnpm db:env` after `pnpm db:start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Internal email domain used to map login IDs to Supabase Auth emails
APP_INTERNAL_EMAIL_DOMAIN=learner.portal.internal

# AI extraction of DBD certificates (P1.5). Provider: claude | fake | off.
# Default: claude when ANTHROPIC_API_KEY is set, otherwise fake outside production and off in production.
ANTHROPIC_API_KEY=
EXTRACTION_PROVIDER=

# Thai read-aloud (P3). Provider: elevenlabs | fake | off.
# Default: elevenlabs when ELEVENLABS_API_KEY is set, otherwise fake outside production and off in production.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
TTS_PROVIDER=

# Exam result notifications (P5). NOTIFY_PROVIDER: live | fake | off (default: live when a key is set).
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=
NOTIFY_PROVIDER=
# Protects /api/cron/notifications (Vercel Cron sends it as a Bearer token). Any long random string.
CRON_SECRET=

# Bank-call training (P8). VAPI_PROVIDER: vapi | fake | off.
# Default: vapi when VAPI_PUBLIC_KEY is set, otherwise fake outside production and off in production.
# The public key is passed to the browser per call; the webhook secret is sent by Vapi as x-vapi-secret.
VAPI_PUBLIC_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_PROVIDER=
# Optional provider overrides for the transient assistant (defaults: deepgram/nova-2/th, 11labs sarah, openai gpt-4o)
VAPI_TRANSCRIBER_PROVIDER=
VAPI_TRANSCRIBER_MODEL=
VAPI_TRANSCRIBER_LANGUAGE=
VAPI_VOICE_PROVIDER=
VAPI_VOICE_ID=
VAPI_VOICE_MODEL=
VAPI_LLM_PROVIDER=
VAPI_LLM_MODEL=
# Public origin of this deployment; used to build the Vapi webhook URL (e.g. https://portal.example.com)
NEXT_PUBLIC_APP_URL=

# AI question authoring (P11). QUESTION_GEN_PROVIDER: claude | fake | off.
# Default: claude when ANTHROPIC_API_KEY is set, otherwise fake outside production and off in production.
QUESTION_GEN_PROVIDER=
