# Supabase (local values come from `pnpm db:env` after `pnpm db:start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Internal email domain used to map login IDs to Supabase Auth emails
APP_INTERNAL_EMAIL_DOMAIN=learner.portal.internal

# AI extraction of DBD certificates (P1.5). Provider: claude | fake | off.
# Default: claude when ANTHROPIC_API_KEY is set, otherwise fake outside production and off in production.
ANTHROPIC_API_KEY=
EXTRACTION_PROVIDER=

# Thai read-aloud (P3). Provider: elevenlabs | fake | off.
# Default: elevenlabs when ELEVENLABS_API_KEY is set, otherwise fake outside production and off in production.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
TTS_PROVIDER=
