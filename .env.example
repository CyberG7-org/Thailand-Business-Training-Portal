# Supabase (local values come from `pnpm db:env` after `pnpm db:start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Internal email domain used to map login IDs to Supabase Auth emails
APP_INTERNAL_EMAIL_DOMAIN=learner.portal.internal

# AI extraction of DBD certificates (P1.5). Provider: claude | fake | off.
# Default: claude when ANTHROPIC_API_KEY is set, otherwise fake outside production and off in production.
ANTHROPIC_API_KEY=
EXTRACTION_PROVIDER=

# Optional server-only Facebook Page reader. When absent, Facebook links are not scraped.
# Community Actor: https://apify.com/api-ninja/facebook-pages-scraper
APIFY_API_TOKEN=

# Thai read-aloud (P3). Provider: elevenlabs | fake | off.
# Default: elevenlabs when ELEVENLABS_API_KEY is set, otherwise fake outside production and off in production.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
TTS_PROVIDER=

# Exam result notifications (P5). NOTIFY_PROVIDER: live | fake | off (default: live when a key is set).
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=
NOTIFY_PROVIDER=
# Protects /api/cron/notifications (Vercel Cron sends it as a Bearer token). Any long random string.
CRON_SECRET=

# AI question authoring (P11). QUESTION_GEN_PROVIDER: claude | fake | off.
# Default: claude when ANTHROPIC_API_KEY is set, otherwise fake outside production and off in production.
QUESTION_GEN_PROVIDER=

# Bank readiness interview (P16). Google AI Studio key, server-only.
# INTERVIEW_PROVIDER: gemini | claude | fake | off. Defaults to Gemini when its key is set,
# otherwise fake outside production and off in production. Claude remains an explicit legacy option.
GEMINI_API_KEY=
GEMINI_INTERVIEW_MODEL=gemini-3.8-flash
GEMINI_FACT_TRANSLATION_MODEL=gemini-2.5-flash
GEMINI_QUIZ_TRANSLATION_MODEL=gemini-2.5-flash
GEMINI_COMPANY_IMAGE_MODEL=gemini-3.8-flash
INTERVIEW_PROVIDER=

# Business-category mapping uses local rules from the two business answers; no AI key is needed.
# Optional "off" disables it for diagnostics. Old claude/gemini/fake values are ignored.
CATEGORY_MAP_PROVIDER=

# DBD retrieval index (P14). VECTOR_PROVIDER: pinecone | fake | off.
# Default: pinecone when PINECONE_API_KEY is set, otherwise fake outside production and off in production.
# Create the index once with `pnpm vector:setup` (multilingual-e5-large, integrated embedding).
PINECONE_API_KEY=
PINECONE_INDEX=thai-portal-dbd
PINECONE_NAMESPACE=dev
PINECONE_REGION=us-east-1
VECTOR_PROVIDER=
# Page transcription model for the index (default claude-sonnet-5) and pages per call (default 5).
TRANSCRIPTION_MODEL=
TRANSCRIBE_SLICE_PAGES=
# Documents with more pages than this are never sent whole; they fill in from their transcripts (default 20).
DIRECT_READ_MAX_PAGES=
# Transcript pages per list-sweep call when filling a record from an oversized document (default 10).
TRANSCRIPT_SWEEP_PAGES=
